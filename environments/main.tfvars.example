project_id = "your-prd-project-id"
region     = "asia-northeast1"

# Common environment variables for all services
common_env_vars = {
  TZ = "Asia/Tokyo"
}

# L1: Global secrets (shared by all environments and services)
global_secret_names = [
  "allowed-emails",
  "basic-auth-password",
  "basic-auth-user",
  "google-client-id",
  "google-client-secret",
  "isr-secret",
  "jwt-private-key",
  "jwt-public-key",
  "supabase-service-role-key",
  "supabase-url",
]

services = {
  "realworld" = {
    github_org  = "motora-dev"
    github_repo = "angular-nestjs-realworld-example-app"

    # L2: Service secrets (with service prefix)
    secret_names = [
      "client-url",
      "cors-origins",
      "csrf-secret",
      "database-url",
      "google-callback-url",
    ]

    common_env_vars = {
      NODE_ENV = "production"
    }

    cloud_run_services = {
      "server" = {
        allow_unauthenticated = true
        memory_limit          = "1Gi"
        health_check_path     = "/api/health"
        env_vars              = {}
        secret_env_vars = {
          DATABASE_URL         = "database-url"
          CLIENT_URL           = "client-url"
          CORS_ORIGINS         = "cors-origins"
          CSRF_SECRET          = "csrf-secret"
          GOOGLE_CLIENT_ID     = "google-client-id"
          GOOGLE_CLIENT_SECRET = "google-client-secret"
          GOOGLE_CALLBACK_URL  = "google-callback-url"
          JWT_PRIVATE_KEY      = "jwt-private-key"
          JWT_PUBLIC_KEY       = "jwt-public-key"
        }
      }
      "client" = {
        allow_unauthenticated = true
        memory_limit          = "1Gi"
        health_check_path     = ""
        container_port        = 4000
        secret_env_vars = {
          ISR_SECRET = "isr-secret"
        }
      }
    }
  }

  "motora-dev" = {
    github_org  = "motora-dev"
    github_repo = "motora-dev"

    # L2: Service secrets (with service prefix)
    secret_names = [
      "cookie-domain",
      "cors-origins",
      "database-url",
      "domain",
    ]

    common_env_vars = {
      NODE_ENV = "production"
    }

    cloud_run_services = {
      "server" = {
        allow_unauthenticated = true
        memory_limit          = "1Gi"
        health_check_path     = "/api/health"
        env_vars              = {}
        secret_env_vars = {
          DATABASE_URL              = "database-url"
          SUPABASE_URL              = "supabase-url"
          SUPABASE_SERVICE_ROLE_KEY = "supabase-service-role-key"
          CORS_ORIGINS              = "cors-origins"
          DOMAIN                    = "domain"
          COOKIE_DOMAIN             = "cookie-domain"
          ALLOWED_EMAILS            = "allowed-emails"
        }
      }
      "client" = {
        allow_unauthenticated = true
        memory_limit          = "1Gi"
        health_check_path     = ""
        container_port        = 4000
        env_vars = {
          BASIC_AUTH_ENABLED = "false"
        }
        secret_env_vars = {
          BASIC_AUTH_USER     = "basic-auth-user"
          BASIC_AUTH_PASSWORD = "basic-auth-password"
          ISR_SECRET          = "isr-secret"
        }
      }
    }
  }
}
